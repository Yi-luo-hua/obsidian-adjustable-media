[
  {
    "name": "mixed bullets",
    "lines": [
      "- a",
      " * b"
    ],
    "sections": [
      {
        "type": "list",
        "from": 0,
        "to": 0
      },
      {
        "type": "list",
        "from": 1,
        "to": 1
      }
    ],
    "expected": [
      "0:after"
    ]
  },
  {
    "name": "ordered indent",
    "lines": [
      "1. a",
      "  - b"
    ],
    "sections": [
      {
        "type": "list",
        "from": 0,
        "to": 0
      },
      {
        "type": "list",
        "from": 1,
        "to": 1
      }
    ],
    "expected": [
      "0:after"
    ]
  },
  {
    "name": "nested list",
    "lines": [
      "1. a",
      "   - b"
    ],
    "sections": [
      {
        "type": "list",
        "from": 0,
        "to": 1
      }
    ],
    "expected": []
  },
  {
    "name": "paragraph list quote",
    "lines": [
      "Text:",
      "- a",
      "> quote"
    ],
    "sections": [
      {
        "type": "paragraph",
        "from": 0,
        "to": 0
      },
      {
        "type": "list",
        "from": 1,
        "to": 2
      }
    ],
    "expected": [
      "0:after",
      "1:after"
    ]
  },
  {
    "name": "lazy quote",
    "lines": [
      "> quote",
      "continued"
    ],
    "sections": [
      {
        "type": "blockquote",
        "from": 0,
        "to": 1
      }
    ],
    "expected": []
  },
  {
    "name": "lazy list",
    "lines": [
      "- a",
      "continued"
    ],
    "sections": [
      {
        "type": "list",
        "from": 0,
        "to": 1
      }
    ],
    "expected": []
  },
  {
    "name": "quote then code",
    "lines": [
      "> quote",
      "    code one",
      "",
      "",
      "    code two",
      "",
      "After."
    ],
    "sections": [
      {
        "type": "blockquote",
        "from": 0,
        "to": 0
      },
      {
        "type": "code",
        "from": 1,
        "to": 4
      },
      {
        "type": "paragraph",
        "from": 6,
        "to": 6
      }
    ],
    "expected": [
      "0:after",
      "5:blank"
    ]
  },
  {
    "name": "list paragraphs",
    "lines": [
      "- a",
      "",
      "    para a",
      "",
      "    para b"
    ],
    "sections": [
      {
        "type": "list",
        "from": 0,
        "to": 4
      }
    ],
    "expected": [
      "1:blank",
      "3:blank"
    ]
  },
  {
    "name": "list code",
    "lines": [
      "- a",
      "",
      "      code one",
      "",
      "      code two",
      "",
      "After."
    ],
    "sections": [
      {
        "type": "list",
        "from": 0,
        "to": 4
      },
      {
        "type": "paragraph",
        "from": 6,
        "to": 6
      }
    ],
    "expected": [
      "1:blank",
      "5:blank"
    ]
  },
  {
    "name": "nested paragraphs",
    "lines": [
      "- a",
      "  - b",
      "",
      "      para a",
      "",
      "      para b"
    ],
    "sections": [
      {
        "type": "list",
        "from": 0,
        "to": 5
      }
    ],
    "expected": [
      "2:blank",
      "4:blank"
    ]
  },
  {
    "name": "heading ends list",
    "lines": [
      "- a",
