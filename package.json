{
  "name": "adjustable-media",
  "version": "0.1.0",
  "description": "An Obsidian plugin for arranging images and videos side by side, stored as plain embeds plus an HTML comment.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "check": "npm run typecheck && npm test",
    "dev": "node esbuild.config.mjs --watch",
    "release": "npm run build && node scripts/prepare-release.mjs",
    "test": "node --test",
    "typecheck": "tsc -p ."
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "images",
    "video",
    "layout"
  ],
  "author": "Yi-luo-hua",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.0"
  }
}
