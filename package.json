{
  "name": "adjustable-media",
  "version": "0.4.0",
  "description": "An Obsidian plugin for arranging images and videos side by side, stored as plain embeds plus an HTML comment.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev": "node esbuild.config.mjs --watch",
    "lint": "eslint .",
    "release": "npm run build && node scripts/prepare-release.mjs",
    "test": "node --test",
    "typecheck": "tsc -p ."
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "images",
    "video",
    "layout"
  ],
  "author": "Yi-luo-hua",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.0"
  }
}
